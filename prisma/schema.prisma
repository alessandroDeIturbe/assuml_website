// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth ──────────────────────────────────────────────────────────────────
model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  role          Role       @default(STUDENT)
  password      String?    // bcrypt hash (Credentials provider)
  paymentInfo   String?    // IBAN / Twint del venditore (visibile ai compratori al momento dell'acquisto)
  createdAt     DateTime   @default(now())

  notes         Note[]
  purchases     Purchase[]
  accounts      Account[]
  sessions      Session[]
  announcements Announcement[]
}

enum Role {
  STUDENT
  ADMIN
}

// NextAuth adapter tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ── Marketplace ───────────────────────────────────────────────────────────
model Note {
  id          String     @id @default(cuid())
  title       String
  description String?    @db.Text
  fileKey     String     // MinIO object key — mai esposto al client
  mimeType    String     @default("application/pdf")
  price       Float      @default(0)
  currency    String     @default("CHF")
  status      NoteStatus @default(PENDING_APPROVAL)
  authorId    String
  author      User       @relation(fields: [authorId], references: [id])
  purchases   Purchase[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  moderatedAt DateTime?
  rejectNote  String?    // motivo rifiuto
}

enum NoteStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model Purchase {
  id             String         @id @default(cuid())
  userId         String
  noteId         String
  stripeId       String         @unique
  amountPaid     Float
  currency       String         @default("CHF")
  purchaseStatus PurchaseStatus @default(ACTIVE)
  receiptKey     String?        // MinIO key della ricevuta di pagamento P2P
  purchasedAt    DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id])
  note           Note           @relation(fields: [noteId], references: [id])
  @@unique([userId, noteId])
}

enum PurchaseStatus {
  PENDING_RECEIPT   // pagamento P2P: in attesa di ricevuta
  PENDING_APPROVAL  // ricevuta caricata, in attesa di conferma admin
  ACTIVE            // acquisto verificato, file accessibile
}

// ── Donazioni ─────────────────────────────────────────────────────────────
model Donation {
  id        String         @id @default(cuid())
  amount    Float
  currency  String         @default("CHF")
  email     String?
  name      String?
  stripeId  String?        @unique
  status    DonationStatus @default(PENDING)
  createdAt DateTime       @default(now())
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
}

// ── Eventi ────────────────────────────────────────────────────────────────
model Event {
  id          String   @id @default(cuid())
  title       String
  tipo        String   @default("Evento")
  luogo       String?
  date        DateTime
  description String?  @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ── Convenzioni ───────────────────────────────────────────────────────────
model Convention {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  imageKey    String?  // MinIO key per la foto
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ── Bacheca Istituzionale ─────────────────────────────────────────────────
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  active    Boolean  @default(true)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
